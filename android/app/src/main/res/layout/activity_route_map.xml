<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗺  Live Route Map"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnBackFromMap"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="← Back"
                android:textColor="@color/primary"
                android:background="@drawable/bg_button_secondary"
                android:textSize="13sp"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <TextView
            android:id="@+id/busInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Fetching live data..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"/>
    </LinearLayout>

    <!-- Map WebView - 50% height -->
    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Route Timeline Card - 50% height -->
    <androidx.cardview.widget.CardView
        android:id="@+id/timelineCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROUTE STOPS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/timelineContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"/>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
